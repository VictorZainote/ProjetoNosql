PORT=3000
# Defina DB_MODE=memory para rodar sem Docker, ou DB_MODE=auto para tentar conectar nos bancos reais e usar fallback em memoria se indisponiveis
DB_MODE=auto

REDIS_URL=redis://localhost:6379
MONGO_URI=mongodb://localhost:27017
MONGO_DB=tickets_pulse
CASSANDRA_CONTACT_POINTS=127.0.0.1
CASSANDRA_DATACENTER=datacenter1
CASSANDRA_KEYSPACE=tickets_pulse
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=ticketspulse123
